# Copy to .env and adjust. Real environment variables override values in .env.

# Transport: stdio (local clients such as Claude Code) or http (Streamable HTTP).
MCP_TRANSPORT=stdio

# HTTP only: bind address, port and MCP endpoint path.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_HTTP_PATH=/mcp

# HTTP only: public base URL when exposed through a tunnel or proxy (e.g. your ngrok dev domain).
# Its host is accepted by the Host-header check. Setting it requires auth (see MCP_AUTH_MODE).
MCP_PUBLIC_URL=

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs always go to stderr.
MCP_LOG_LEVEL=INFO

# HTTP auth: none, bearer or oauth.
MCP_AUTH_MODE=none

# Allow auth mode "none" on a publicly reachable server. Never use this with a tunnel.
MCP_ALLOW_INSECURE=false

# Bearer mode: shared secret, at least 32 characters.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_AUTH_TOKEN=

# OAuth mode: authorization server issuer, its JWKS URL, and this server's canonical URL (incl. path).
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_RESOURCE_URL=
# Comma-separated scopes every token must contain (optional).
MCP_OAUTH_REQUIRED_SCOPES=
